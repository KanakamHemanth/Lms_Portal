{
  "info": {
    "_postman_id": "coursecraft-lms-full-collection",
    "name": "CourseCraft LMS API - Full CRUD & Auth Collection",
    "description": "Complete Postman collection for CourseCraft LMS API. Covers all HTTP methods (GET, POST, PUT, DELETE) for Users, Instructors, Authentication, and Courses with automated token extraction and variable handling.",
