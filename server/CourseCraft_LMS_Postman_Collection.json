    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Instructor (POST)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `instructor.${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('user_email', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.user && (data.user.id || data.user._id)) {",
                  "    pm.collectionVariables.set('user_id', data.user.id || data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Instructor\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"role\": \"instructor\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new instructor into the LMS."
          },
          "response": []
        },
        {
          "name": "Register Student (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"student.{{$timestamp}}@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new student into the LMS."
          },
          "response": []
        },
        {
          "name": "Login Instructor (POST - Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Successful 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "const token = data.token || data.Token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    pm.collectionVariables.set('instructor_token', token);",
                  "    console.log('Saved token to collection variables!');",
                  "}",
                  "if (data.user && (data.user.id || data.user._id)) {",
                  "    pm.collectionVariables.set('user_id', data.user.id || data.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in the newly registered instructor and automatically saves the JWT token into {{token}}."
          },
          "response": []
        },
        {
          "name": "Login Seeded Admin (POST - Saves Admin Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin Login 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "const token = data.token || data.Token;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in with the seeded admin account to manage any user or course."
          },
          "response": []
        },
        {
          "name": "Get Profile /me (GET)",
