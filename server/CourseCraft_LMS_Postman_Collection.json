            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            },
            "description": "Directly adds a new user or instructor (role can be 'instructor', 'student', or 'admin'). Saves the new user ID to {{user_id}}."
