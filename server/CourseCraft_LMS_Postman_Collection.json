            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Master Instructor\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Updates current logged-in user profile."
          },
          "response": []
        }
      ]
